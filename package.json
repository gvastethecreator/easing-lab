{
  "name": "easing-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Laboratorio interactivo de easing con React, GSAP, Tailwind CSS y Vite+.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "bun ./scripts/run-with-log.mjs preview vp preview",
    "lint": "bun ./scripts/run-with-log.mjs lint vp lint",
    "lint:fix": "bun ./scripts/run-with-log.mjs lint-fix vp lint --fix",
    "format": "bun ./scripts/run-with-log.mjs format vp fmt",
    "format:check": "bun ./scripts/run-with-log.mjs format-check vp fmt --check",
    "typecheck": "bun ./scripts/run-with-log.mjs typecheck tsc --noEmit",
    "test": "bun ./scripts/run-with-log.mjs test vp test",
    "coverage": "bun ./scripts/run-with-log.mjs coverage vitest run --coverage",
    "metrics": "bun ./scripts/run-with-log.mjs metrics bun ./scripts/collect-metrics.mjs",
    "check": "bun ./scripts/run-with-log.mjs check vp check"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.63.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.11"
}
