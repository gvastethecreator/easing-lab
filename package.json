{
  "name": "easing-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Laboratorio visual de curvas para CSS, GSAP, Motion, Anime.js y Three.js.",
  "homepage": "https://github.com/gvastethecreator/easing-lab",
  "bugs": {
    "url": "https://github.com/gvastethecreator/easing-lab/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/easing-lab.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/run-with-log.mjs dev vp dev",
    "build": "bun scripts/run-with-log.mjs build vp build",
    "preview": "bun scripts/run-with-log.mjs preview vp preview",
    "lint": "bun scripts/run-with-log.mjs lint vp lint",
    "lint:fix": "bun scripts/run-with-log.mjs lint-fix vp lint --fix",
    "format": "bun scripts/run-with-log.mjs format vp fmt",
    "format:check": "bun scripts/run-with-log.mjs format-check vp fmt --check",
    "typecheck": "bun scripts/run-with-log.mjs typecheck tsc --noEmit",
    "test": "bun scripts/run-with-log.mjs test vp test",
    "coverage": "bun scripts/run-with-log.mjs coverage vitest run --coverage",
    "check": "bun scripts/run-with-log.mjs check vp check",
    "deps": "bun scripts/run-with-log.mjs deps bun outdated",
    "unused": "bun scripts/run-with-log.mjs unused knip --production",
    "metrics": "bun scripts/run-with-log.mjs metrics bun scripts/collect-metrics.mjs",
    "verify": "bun scripts/verify.mjs"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "gsap": "^3.15.0",
    "motion": "12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plus": "^0.2.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14"
}
